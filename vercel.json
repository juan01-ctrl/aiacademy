{
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "executor",
          "format": "url",
          "env": "EXECUTOR_URL"
        }
      ]
    },
    "executor": {
      "root": "apps/executor/",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}

AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Configure this same random value in the web and executor services.
EXECUTOR_SERVICE_TOKEN=replace-with-a-random-service-secret
# EXECUTOR_URL is injected at runtime by the Vercel service binding; do not set it manually.
DATABASE_URL=postgresql://user:password@localhost:5432/academy
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/academy
